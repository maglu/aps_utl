# Sample network.env file
# To use with aps.py, either source this file or just let aps.py parse it.
# The format is APS_<DEVICE>_<ENTITY>_<PROPERTY>=<VALUE>
# Devices usually consist of RT, NRT, and optionally BBB entities.

# ----------------------------
# Device Cluster 1: dev1
# ----------------------------
# RT Machine
export APS_DEV1_RT_MODE=ssh
export APS_DEV1_RT_IP=192.168.1.100
export APS_DEV1_RT_PORT=1022
export APS_DEV1_RT_USERNAME=root
export APS_DEV1_RT_PASSWORD=""

# NRT Machine
export APS_DEV1_NRT_MODE=ssh
export APS_DEV1_NRT_IP=192.168.1.100
export APS_DEV1_NRT_PORT=22
export APS_DEV1_NRT_USERNAME=root
export APS_DEV1_NRT_PASSWORD=""

# BBB Machine (Optional)
export APS_DEV1_BBB_MODE=uart
export APS_DEV1_BBB_IP=192.168.1.200
export APS_DEV1_BBB_USERNAME=debian
export APS_DEV1_BBB_PASSWORD=magnus
export APS_DEV1_BBB_UART_PORT=/dev/ttyUSB0
export APS_DEV1_BBB_BAUDRATE=115200

# ----------------------------
# Macro specific variables
# ----------------------------
export WIFI_IP=192.168.2.50
